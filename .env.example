# OpenLLMOps 本地/单机部署配置模板。
# 复制为 .env 后务必替换所有 CHANGE_ME 值；真实密钥禁止提交到 Git。

# PostgreSQL
POSTGRES_DB=openllmops
POSTGRES_USER=openllmops
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://openllmops:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/openllmops

# 控制面安全
APP_ENV=production
APP_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_ADMIN_PASSWORD
PUBLIC_BASE_URL=https://openllmops.local
TLS_CERT_PATH=/run/secrets/tls.crt
TLS_KEY_PATH=/run/secrets/tls.key

# 单机 GPU 调度：开发环境可设为 0,1，生产 4 卡设为 0,1,2,3。
GPU_DEVICE_IDS=0,1,2,3
GPU_LEASE_TTL_SECONDS=30
SCHEDULER_POLL_INTERVAL_SECONDS=2

# 受控数据目录。模型人工拷入 MODEL_INBOX_DIR 后，仍需在界面发起校验和导入。
DATA_ROOT=/srv/openllmops
MODEL_INBOX_DIR=/srv/openllmops/inbox/models
MODEL_STORE_DIR=/srv/openllmops/models
DATASET_STORE_DIR=/srv/openllmops/datasets
ARTIFACT_STORE_DIR=/srv/openllmops/artifacts

# 动态工作负载镜像使用固定版本，升级时显式修改，避免 latest 漂移。
VLLM_IMAGE=vllm/vllm-openai:v0.10.1.1
LLAMAFACTORY_IMAGE=hiyouga/llamafactory:0.9.3
EVALUATION_IMAGE=openllmops/evaluation:0.1.0
TRUST_REMOTE_CODE=false

# Node Agent 仅接受来自控制面的签名请求，并只允许下列镜像前缀。
NODE_AGENT_URL=http://node-agent:8090
NODE_AGENT_SHARED_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
NODE_AGENT_ALLOWED_IMAGE_PREFIXES=vllm/vllm-openai:,hiyouga/llamafactory:,openllmops/evaluation:

# 监控
PROMETHEUS_RETENTION=15d
LOG_LEVEL=INFO
