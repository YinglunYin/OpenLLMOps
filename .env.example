# 仅用于无 GPU 的后端本地开发。生产环境必须从 deploy/.env.example 创建 deploy/.env，
# 不要把这里的关闭鉴权/非安全 Cookie 配置复制到服务器。
ENVIRONMENT=development
DEBUG=true
AUTO_CREATE_TABLES=true
DATABASE_URL=sqlite+aiosqlite:///./openllmops.db

# 本地前端通过 /auth/me 获得 disabled 管理员身份，便于联调真实 CRUD 接口。
AUTH_ENABLED=false
ADMIN_USERNAME=admin
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=

# 无 Node Agent/GPU 时关闭后台协调；对应 API 和队列状态仍可本地测试。
RECONCILER_ENABLED=false
MODEL_IMPORT_COORDINATOR_ENABLED=false
GPU_COUNT=2

# 评测路径合同要求绝对路径；本地开发统一放到可随时清理的临时目录。
MODEL_ROOT=/tmp/openllmops-dev/models
MODEL_INBOX_ROOT=/tmp/openllmops-dev/inbox
MODEL_STAGING_ROOT=/tmp/openllmops-dev/model-staging
DATASET_ROOT=/tmp/openllmops-dev/datasets
CHECKPOINT_ROOT=/tmp/openllmops-dev/checkpoints
EVALUATION_DATASET_ROOT=/tmp/openllmops-dev/evaluation-datasets
EVALUATION_OUTPUT_ROOT=/tmp/openllmops-dev/evaluation-output
NODE_AGENT_RUNTIME_ROOT=/tmp/openllmops-dev/runtime

PROMETHEUS_URL=http://127.0.0.1:9090
