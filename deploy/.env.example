# 复制为 deploy/.env 后再启动。以下值必须替换，切勿提交真实凭证。
POSTGRES_PASSWORD=replace-with-a-long-random-password
# 生成真实 Argon2id 哈希后填入；必须用单引号包裹，避免其中的 $ 被 Compose 插值。
# 格式示例（不能直接使用）：ADMIN_PASSWORD_HASH='$argon2id$v=19$m=...'
ADMIN_PASSWORD_HASH=
SESSION_SIGNING_KEY=replace-with-an-independent-session-secret-at-least-32-characters
ADMIN_API_KEY=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-an-independent-random-secret
NODE_AGENT_TOKEN=replace-with-another-32-character-random-token

AUTH_ENABLED=true
ADMIN_USERNAME=admin
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
# Web/Nginx 使用固定控制网 IP；只信任该单一地址，不要把整个控制网或 * 设为代理。
CONTROL_SUBNET=172.30.10.0/24
WEB_PROXY_IP=172.30.10.10
TRUSTED_PROXY_CIDRS=172.30.10.10/32

# 生产默认为 4 张 RTX 4090D；双卡开发机只需改为 2，node-agent 会同时校验 GPU 编号。
GPU_COUNT=4
OPENLLMOPS_STORAGE_ROOT=/srv/openllmops
APP_UID=1000
APP_GID=1000
WORKLOAD_UID=1000
WORKLOAD_GID=1000

# 显式声明已审计 vLLM 镜像的 CUDA 变体。cu130 对应 CUDA 13.0.2，
# 要求所有 GPU 的宿主驱动 >= 580.95.05。驱动暂时无法升级时，
# 才将此项改为 cu129，并同时替换下方推理与评测基础镜像。
CUDA_VARIANT=cu130
# 动态工作负载只允许使用精确列出的镜像（逗号分隔）。vLLM 默认为官方
# v0.27.1（CUDA 13.0.2）；ENVIRONMENT=production 时预检强制使用完整 digest。
VLLM_ALLOWED_IMAGES=vllm/vllm-openai:v0.27.1
# CUDA 13 官方 amd64：vllm/vllm-openai@sha256:c2f3b1b964e47809b722b5e75b61b1e7b39a50f70388cf2bf2418f16a9f31da2
# cu129 回退变体为 CUDA 12.9.1，要求驱动 >= 575.57.08；其官方 amd64：
# vllm/vllm-openai@sha256:6666717cd1cadf9adfff8abec9c3f2eca6e27e742de06fe7d7f129fa3d647732
LLAMAFACTORY_SECURE_IMAGE=openllmops/llamafactory-secure:0.9.6.dev0-c4e09c7-rcefix1
# 本地构建 tag 只用于 development；production 必须把运行白名单替换为
# 内部仓库返回且保留安全标签的 repository@sha256:<digest> 引用。
LLAMAFACTORY_ALLOWED_IMAGES=openllmops/llamafactory-secure:0.9.6.dev0-c4e09c7-rcefix1
# 评测镜像以同一个 vLLM 0.27.1 基础镜像构建；生产的基础镜像
# 和 EVALUATION_ALLOWED_IMAGES 同样必须换成 digest，且必须保留项目安全标签。
EVALUATION_VLLM_BASE_IMAGE=vllm/vllm-openai:v0.27.1
EVALUATION_IMAGE=openllmops/evaluation:0.1.0-vllm0.27.1
EVALUATION_ALLOWED_IMAGES=openllmops/evaluation:0.1.0-vllm0.27.1
WORKLOAD_SHM_SIZE=16g
ENFORCE_NVML_PROCESS_CHECK=true
NODE_AGENT_CLOCK_SKEW_SECONDS=30
NODE_AGENT_TIMEOUT_SECONDS=10
# 开发验证可缩短启动窗口；正式大模型首次 JIT 较慢，调整前应保留观测余量。
INFERENCE_STARTUP_TIMEOUT_SECONDS=1800
INFERENCE_UNHEALTHY_TIMEOUT_SECONDS=60
INFERENCE_FAILURE_STOP_TIMEOUT_SECONDS=30
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_SECONDS=2
GPU_LEASE_TTL_SECONDS=30
MODEL_IMPORT_COORDINATOR_ENABLED=true
MODEL_IMPORT_POLL_INTERVAL_SECONDS=1
MODEL_IMPORT_CONCURRENCY=1
MODEL_IMPORT_CLAIM_TIMEOUT_SECONDS=120
# 可选令牌只能放在宿主机只读文件中，不能把明文令牌写入此 .env。
MODEL_SOURCE_SECRETS_DIR=./secrets/model-sources
HUGGINGFACE_TOKEN_FILE=
MODELSCOPE_TOKEN_FILE=

# 本文件默认生产模式，因此启动前必须把 vLLM、训练与评测白名单改成 digest；
# 仅本地开发才可改为 development 并保留上面的固定 tag。
ENVIRONMENT=production
DEBUG=false
AUTO_CREATE_TABLES=false
RUN_MIGRATIONS=true
CORS_ORIGINS=["https://openllmops.local"]
PROMETHEUS_TIMEOUT_SECONDS=3

# 首次体验可自动生成自签名证书；正式环境请放置 tls.crt/tls.key 并关闭自动生成。
TLS_AUTO_GENERATE=true
TLS_COMMON_NAME=openllmops.local
TLS_DIR=./secrets/tls
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# 镜像版本均可在升级验证后显式覆盖，避免无意跟随 latest。
POSTGRES_IMAGE=postgres:17-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.4.1-4.5.2-ubuntu22.04
DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0

PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=20GB
VITE_API_BASE_URL=/api
VITE_USE_MOCKS=false
